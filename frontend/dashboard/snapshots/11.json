utton class=\"on\" data-cong=\"0\">보통</button><button class=\"\" data-cong=\"5\">5분</button><button class=\"\" data-cong=\"10\">10분</button><button class=\"\" data-cong=\"15\">15분</button></div>\n    <span class=\"clock\" id=\"clock\">19:01</span>\n  </header>\n  <main>\n    <section class=\"left\">\n      <div class=\"tabs\" id=\"tabs\"><button class=\"on\" data-tab=\"NEW\">신규<span class=\"n \">0</span></button><button class=\"\" data-tab=\"ACCEPTED\">처리중<span class=\"n \">0</span></button><button class=\"\" data-tab=\"DONE\">완료<span class=\"n \">0</span></button></div>\n      <div class=\"list\" id=\"list\"><div class=\"empty\">신규 주문이 없어요</div></div>\n      <div class=\"waiting\" id=\"waiting\"><b>(시연용) 전송 대기 1건</b> — 실제 매장에는 보이지 않아요<div class=\"w\"><span class=\"mode DELIVERY\">배달</span><span>19:19 전송 예정</span><span>17분 59초</span><span>청양마요치킨 1</span></div></div>\n    </section>\n    <section class=\"detail\" id=\"detail\"><div class=\"card empty\">새 주문이 들어오면 여기에 보여요.<br>DriveOn이 고객 도착 시각에 맞춰 주문을 보냅니다.</div></section>\n  </main>\n  \n  \n\n\n","posStyle":"\n    /* 배달앱 사장님용 주문접수 화면식: 민트 머리띠, 왼쪽 신규·처리중·완료 목록, 오른쪽 주문 상세와 큰 접수 버튼 */\n    :root {\n      --mint: #2ac1bc; --mint-press: #1fa9a4; --mint-soft: #e8f8f7;\n      --ink: #1e1e1e; --sub: #6f6f6f; --faint: #a0a0a0; --line: #e8e8e8; --gray: #f2f3f5; --white: #ffffff;\n      --red: #ef4f56; --orange: #ff7a00; --green-bg: #e7f8ee; --green: #16a05a;\n      --f-title: 'Do Hyeon', 'Noto Sans KR', 'Malgun Gothic', sans-serif;\n      --f-badge: 'Jua', 'Noto Sans KR', 'Malgun Gothic', sans-serif;\n      --f-body: 'Noto Sans KR', 'Malgun Gothic', 'Apple SD Gothic Neo', system-ui, sans-serif;\n      color-scheme: light;\n    }\n    body { background: var(--gray); color: var(--ink); font-family: var(--f-body); display: grid; grid-template-rows: auto 1fr; height: 100vh; overflow: hidden; }\n    button { font-family: var(--f-body); color: var(--ink); background: var(--white); border: 1px solid var(--line); }\n    button:hover { border-color: #cfcfcf; }\n    button:focus-visible { outline: 2px solid var(--mint-press); outline-offset: 2px; }\n\n    header { background: var(--mint); color: #fff; display: flex; align-items: center; gap: 12px; padding: 10px 16px; flex-wrap: wrap; }\n    header h1 { font-family: var(--f-title); font-weight: 400; font-size: 26px; margin: 0; }\n    header .demo { font-size: 12px; border: 1px solid rgba(255,255,255,.6); border-radius: 999px; padding: 1px 8px; }\n    header select { font: inherit; font-size: 15px; color: var(--ink); background: #fff; border: 0; border-radius: 8px; padding: 6px 10px; }\n    header .open { font-family: var(--f-badge); background: #fff; color: var(--mint-press); border-radius: 999px; padding: 2px 10px; font-size: 14px; }\n    header .sp { flex: 1; }\n    header .clock { font-size: 24px; font-weight: 900; font-variant-numeric: tabular-nums; }\n    .busy { display: flex; align-items: center; gap: 4px; font-size: 14px; }\n    .busy button { background: rgba(255,255,255,.2); color: #fff; border: 1px solid rgba(255,255,255,.5); border-radius: 8px; padding: 4px 10px; font-size: 14px; }\n    .busy button.on { background: #fff; color: var(--mint-press); font-weight: 700; }\n    .busy button:disabled { opacity: .5; }\n\n    main { display: grid; grid-template-columns: minmax(280px, 380px) minmax(0, 1fr); gap: 0; min-height: 0; }\n    .left { background: var(--white); border-right: 1px solid var(--line); display: grid; grid-template-rows: auto 1fr auto; min-height: 0; }\n    .tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }\n    .tabs button { border: 0; border-radius: 0; background: transparent; padding: 14px 6px 11px; font-size: 17px; color: var(--sub); border-bottom: 3px solid transparent; }\n    .tabs button.on { color: var(--ink); font-weight: 900; border-bottom-color: var(--mint); }\n    .tabs .n { font-family: var(--f-badge); display: inline-grid; place-items: center; min-width: 22px; height: 22px; border-radius: 11px; padding: 0 6px; margin-left: 4px; font-size: 13px; background: var(--gray); color: var(--sub); }\n    .tabs .n.hot { background: var(--red); color: #fff; }\n    .list { overflow: auto; min-height: 0; }\n    .item { display: grid; gap: 4px; width: 100%; text-align: left; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; padding: 14px 16px; background: #fff; }\n    .item.sel { background: var(--mint-soft); box-shadow: inset 4px 0 0 var(--mint); }\n    .item .r1 { display: flex; align-items: center; gap: 8px; }\n    .item .tm { font-size: 20px; font-weight: 900; font-variant-numeric: tabular-nums; }\n    .item .r2 { font-size: 15px; }\n    .item .r3 { font-size: 13px; color: var(--sub); display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }\n    .item .st { margin-left: auto; font-size: 13px; color: var(--sub); }\n    .new-dot { font-family: var(--f-badge); background: var(--red); color: #fff; border-radius: 4px; padding: 0 6px; font-size: 13px; animation: blink 1s steps(2, start) 6; }\n    .mode { font-family: var(--f-badge); font-size: 14px; border-radius: 4px; padding: 0 6px; }\n    .mode.DELIVERY { color: var(--mint-press); background: var(--mint-soft); }\n    .mode.PICKUP { color: var(--orange); background: #fff2e5; }\n    .plate { font-weight: 900; letter-spacing: .03em; background: var(--ink); color: #fff; border-radius: 4px; padding: 0 6px; font-size: 13px; }\n    .here { font-family: var(--f-badge); color: var(--green); background: var(--green-bg); border-radius: 4px; padding: 0 6px; font-size: 13px; }\n    .empty { color: var(--faint); padding: 28px 16px; text-align: center; font-size: 15px; }\n    .waiting { border-top: 1px dashed var(--line); padding: 10px 16px 12px; font-size: 13px; color: var(--sub); background: #fafafa; }\n    .waiting b { color: var(--ink); }\n    .waiting .w { display: flex; gap: 8px; padding: 3px 0; font-variant-numeric: tabular-nums; }\n\n    .detail { overflow: auto; min-height: 0; padding: 16px; display: grid; gap: 12px; align-content: start; }\n    .card { background: var(--white); border-radius: 12px; padding: 16px 18px; }\n    .d-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }\n    .d-head .mode { font-size: 18px; padding: 2px 10px; }\n    .d-head h2 { font-family: var(--f-title); font-weight: 400; font-size: 30px; margin: 0; }\n    .d-head .id { margin-left: auto; color: var(--faint); font-size: 13px; }\n    .arrived { display: flex; align-items: center; gap: 10px; background: var(--green-bg); color: var(--green); border-radius: 10px; padding: 12px 14px; font-size: 18px; font-weight: 900; }\n    .kv { display: grid; grid-template-columns: auto 1fr; gap: 8px 18px; font-size: 16px; }\n    .kv span:nth-child(odd) { color: var(--sub); }\n    .kv b { font-variant-numeric: tabular-nums; }\n    .kv .big { font-size: 22px; }\n    .moved { color: var(--orange); font-size: 14px; }\n    .lines .ln { display: flex; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line); font-size: 18px; }\n    .lines .ln:last-child { border-bottom: 0; }\n    .lines .ln .nm { flex: 1; min-width: 0; font-weight: 700; }\n    .lines .ln .nm small { display: block; color: var(--sub); font-weight: 400; font-size: 14px; }\n    .lines .ln .q { font-weight: 900; width: 40px; text-align: center; }\n    .lines .ln .p { width: 100px; text-align: right; font-variant-numeric: tabular-nums; }\n    .sum { display: flex; justify-content: space-between; font-size: 16px; padding: 3px 0; font-variant-numeric: tabular-nums; }\n    .sum.total { font-size: 20px; font-weight: 900; border-top: 1px solid var(--line); margin-top: 6px; padding-top: 10px; }\n    .paid { font-size: 14px; color: var(--sub); margin-top: 6px; }\n    .actions { display: grid; grid-template-columns: 1fr 2fr; gap: 10px; }\n    .actions button { padding: 18px; font-size: 20px; border-radius: 12px; font-weight: 700; }\n    .actions .go { background: var(--mint); border-color: var(--mint); color: #fff; }\n    .actions .go:hover { background: var(--mint-press); }\n    .actions .done { background: var(--gray); color: var(--sub); border-color: var(--line); grid-column: 1 / -1; }\n    .note { font-size: 13px; color: var(--sub); }\n    .flash { animation: pop 1.4s ease-out 3; }\n    @keyframes pop { 0% { box-shadow: 0 0 0 0 rgba(42,193,188,.6); } 70% { box-shadow: 0 0 0 14px rgba(42,193,188,0); } }\n    @keyframes blink { to { visibility: hidden; } }\n    @media (prefers-reduced-motion: reduce) { .new-dot, .flash { animation: none; } }\n    @media (max-width: 760px) {\n      body { height: auto; overflow: auto; }\n      main { grid-template-columns: 1fr; }\n      .left { border-right: 0; }\n      .list { max-height: 320px; }\n    }\n    .conn { color: var(--sub); }\n  "}